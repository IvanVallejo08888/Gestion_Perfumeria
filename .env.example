# ============================================================
#  Variables de entorno — copia este archivo como ".env"
# ============================================================

# Cadena de conexión a PostgreSQL.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_perfumerias?schema=public"

# Clave secreta para firmar las sesiones (mínimo 32 caracteres).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-secreta-de-al-menos-32-caracteres"

# Datos del ÚNICO administrador. El script "npm run db:seed" lo crea si no existe.
# (Si el administrador cambia su contraseña desde la app, volver a ejecutar el seed NO la sobrescribe.)
ADMIN_IDENTIFICACION="12345987600"
ADMIN_PASSWORD="AdministradorGestion2026$"
ADMIN_NOMBRE="Administrador"
ADMIN_CORREO="admin@gestion.local"
